server:
  port: 8080
  context_path: /api

database:
  host: localhost
  port: 3306
  name: ai_comic_generator
  user: root
  password:  # 请填写实际密码
  max_idle_conns: 10
  max_open_conns: 100

redis:
  host: localhost
  port: 6379
  db: 0
  password: ""

session:
  secret: "change-me-to-a-long-random-string"
  max_age: 604800
  secure: false
  same_site: "lax"
  
cors:
  allow_origins:
    - "http://localhost:5173"

log:
  level: info
  file_path: ""

# 步骤 1–3：通义千问 qwen-plus（LangChainGo OpenAI 兼容）
ai:
  dashscope:
    api_key: "sk-xxx"
    model: "qwen-plus"
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  # Prompt 语言：zh（中文，适用通义千问）/ en（英文，适用 GPT 模型）
  prompt_lang: "zh"
  # 步骤 4：腾讯混元生图（未配置时开发模式用占位图）
  hunyuan:
    enabled: false
    secret_id: ""
    secret_key: ""
    region: "ap-guangzhou"
    model: "hunyuan-image"
  # 图片生成后端选择：hunyuan | openai_image_1k | openai_image_4k
  image_backend: "hunyuan" 
  openai_image_1k:
    enabled: false
    api_key: ""
    model: "gpt-image-2"
    base_url: "https://api.wszhu.top"  
    timeout: 120                           # 超时时间（秒）
    size: "1024x1024"                      # 图片尺寸（1024x1024 | 1792x1024 | 1024x1792）
    quality: "standard"                    # 图片质量（standard | hd，部分中转站不支持 hd）
  openai_image_4k:
    enabled: false
    api_key: ""
    model: "gpt-image-2-4k"
    base_url: "https://api.wszhu.top"    
    timeout: 120                           # 超时时间（秒）
    size: "1024x1024"                      # 图片尺寸（1024x1024 | 1792x1024 | 1024x1792）
    quality: "hd"                    # 图片质量（standard | hd，部分中转站不支持 hd）  

# 漫画图片本地存储（步骤 4–5 输出）
storage:
  base_path: "./comics"
  public_url: "/comics"

# 步骤 4–5：腾讯云 COS 图片存储（未配置时使用本地 URL）
cos:
  enabled: true
  bucket_url: ""
  secret_id: ""
  secret_key: ""

# 步骤 6：微信公众号（未配置时仅标记 DRAFT）
wechat:
  enabled: false
  app_id: ""
  app_secret: ""

# 积分充值（支付宝当面付扫码）
pay:
  mock_enabled: true
  notify_base_url: "https://your-domain.com/api"  # 必须公网 HTTPS
  return_base_url: "https://your-domain.com"   # 电脑网站支付付完跳回
  packages:
    - code: p60
      name: "入门包"
      amount_fen: 600      # ¥6.00
      points: 60
    - code: p180
      name: "常用包"
      amount_fen: 1800
      points: 200
    - code: p680
      name: "创作包"
      amount_fen: 6800
      points: 800
  alipay:
    enabled: false           # true 表示打开真实支付宝
    app_id: ""
    private_key: ""          # 应用私钥 PKCS1，勿提交
    alipay_public_key: ""    # 支付宝公钥（不是应用公钥）
    sandbox: true            # 沙箱 true，正式 false
    mode: "qrcode"           # qrcode=当面付扫码；page=电脑网站支付（需开通产品并配置 return_base_url）
